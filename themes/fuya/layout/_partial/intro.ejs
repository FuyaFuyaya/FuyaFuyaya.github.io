<div id="intro-stage" class="intro-stage">
  <div class="intro-content">
    <div class="svg-container">
      <svg viewBox="0 0 400 300" class="intro-svg">
        <!-- 手帳外框與頁面線條 -->
        <path class="draw-path line-notebook" d="M 80 50 L 320 50 C 330 50 330 250 320 250 L 80 250 C 70 250 70 50 80 50 Z" />
        <path class="draw-path line-spine" d="M 200 50 L 200 250" />
        <path class="draw-path line-detail" d="M 100 90 L 180 90 M 100 120 L 180 120 M 100 150 L 160 150" />
        
        <!-- 紙膠帶 -->
        <rect class="draw-path washi-tape" x="230" y="70" width="70" height="25" rx="3" transform="rotate(-5 265 82)" />
        
        <!-- 手寫鋼筆線條 -->
        <path class="draw-path line-pen" d="M 220 180 C 240 160 260 200 280 170" />
        
        <!-- 貓咪蓋章 -->
        <g class="stamp-group">
          <circle cx="260" cy="130" r="22" class="stamp-bg" />
          <path class="stamp-icon" d="M 250 135 C 250 125 255 120 260 120 C 265 120 270 125 270 135 M 252 125 L 248 118 L 256 122 M 268 125 L 272 118 L 264 122" />
        </g>
      </svg>
    </div>
    
    <div class="intro-text-group">
      <h1 class="intro-title"><%- config.title || '芙婭的手帳角落' %></h1>
      <p class="intro-subtitle"><%- config.subtitle || "Fuya's Journal Corner" %></p>
    </div>
    
    <button id="enter-btn" class="enter-btn" aria-label="Enter site">
      <span>ENTER</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>
</div>