<%#
  themes/fuya/layout/index.ejs
  手帳風首頁樣板（整合示範版動畫）
%>
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<title><%= config.title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Noto+Serif+TC:wght@400;600&family=Noto+Sans+TC:wght@300;400;500;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%- url_for('css/base.css') %>">
<link rel="stylesheet" href="<%- url_for('css/home.css') %>">
<!-- 引入示範版的 CSS -->
<%- css('css/intro.css') %>
</head>
<body class="intro-active">

<!-- 引入示範版動畫組件 -->
<%- partial('_partial/intro') %>

<div class="spine"><div class="holes"></div><div class="rule"></div></div>

<div class="tabs">
<a class="tab home active" href="<%- url_for('/') %>">主頁</a>
<a class="tab gacha" href="<%- url_for('/categories/轉蛋/') %>">轉蛋</a>
<a class="tab commission" href="<%- url_for('/categories/委託/') %>">委託</a>
<a class="tab chat" href="<%- url_for('/categories/雜談/') %>">雜談</a>
<a class="tab project" href="<%- url_for('/project/') %>">企劃</a>
</div>

<div class="content-shift">
<div class="wrap">

<div class="stamp-wrap">
<svg class="stamp-svg" width="140" height="130" viewBox="0 0 160 150">
<path d="M64,45 L59,27 L76,41 Z" fill="none" stroke="var(--rose-dark)" stroke-width="2" stroke-linejoin="round"/>
<path d="M96,45 L101,27 L84,41 Z" fill="none" stroke="var(--rose-dark)" stroke-width="2" stroke-linejoin="round"/>
<circle cx="80" cy="58" r="21" fill="var(--bg-card)" stroke="var(--rose-dark)" stroke-width="2"/>
<circle cx="72" cy="57" r="1.8" fill="var(--rose-dark)"/>
<circle cx="88" cy="57" r="1.8" fill="var(--rose-dark)"/>
<path d="M78,63 L82,63 L80,66 Z" fill="var(--rose-dark)"/>
<path d="M80,66 Q80,69 80,69" fill="none" stroke="var(--rose-dark)" stroke-width="1.3"/>
<path d="M58,62 L45,59 M58,66 L45,68" fill="none" stroke="var(--rose-dark)" stroke-width="1.2" stroke-linecap="round"/>
<path d="M102,62 L115,59 M102,66 L115,68" fill="none" stroke="var(--rose-dark)" stroke-width="1.2" stroke-linecap="round"/>
<text x="80" y="107" text-anchor="middle" font-family="Klee One, cursive" font-weight="600" font-size="24" fill="var(--rose-dark)">芙婭</text>
<text x="80" y="124" text-anchor="middle" font-family="Klee One, cursive" font-size="8" letter-spacing="3" fill="var(--rose-dark)" opacity="0.75">FUYA'S DIARY</text>
</svg>
<p class="stamp-tagline">轉蛋・委託・偶爾碎碎念</p>
</div>

<%
var featuredPost = site.posts.data.find(function(p){ return p.featured; });
if (!featuredPost) { featuredPost = site.posts.sort('date', -1).data[0]; }
%>
<% if (featuredPost) { %>
<div class="featured">
<div class="tape"></div>
<div class="kicker">本月精選 · <%= featuredPost.categories && featuredPost.categories.data[0] ? featuredPost.categories.data[0].name : '' %></div>
<blockquote><%= featuredPost.excerpt || featuredPost.description || '' %></blockquote>
<div class="title-row">
<div>
<h2><%= featuredPost.title %></h2>
<div class="meta"><%= date(featuredPost.date, 'YYYY.MM.DD') %></div>
</div>
<a class="read" href="<%- url_for(featuredPost.path) %>">閱讀全文 →</a>
</div>
</div>
<% } %>

<%
var ingPosts = site.posts.data.filter(function(p){
  var cats = p.categories ? p.categories.data.map(function(c){ return c.name; }) : [];
  return cats.indexOf('企劃') !== -1 && p.status && p.status !== '已完成';
});
%>
<% if (ingPosts.length) { %>
<div class="ing-section">
<svg class="doodle" style="top:-14px; left:180px; width:20px;" viewBox="0 0 20 20"><path d="M10 1 L12 7.5 L19 7.5 L13.3 11.7 L15.4 18.5 L10 14.3 L4.6 18.5 L6.7 11.7 L1 7.5 L8 7.5 Z" fill="#C9A054"/></svg>
<svg class="doodle" style="top:6px; right:10px; width:16px; --r:10deg;" viewBox="0 0 20 20"><path d="M10 17 C4 12 1 8.5 1 5.5 C1 3 3 1 5.5 1 C7.3 1 9 2 10 3.6 C11 2 12.7 1 14.5 1 C17 1 19 3 19 5.5 C19 8.5 16 12 10 17 Z" fill="#B98289"/></svg>
<div class="ing-title"><span class="pencil">✏️</span> 企劃 ing</div>
<div class="ing-grid">
<% ingPosts.forEach(function(p){ %>
<div class="ing-card">
<div class="status"><span class="dot"></span><%= p.status %></div>
<h4><a href="<%- url_for(p.path) %>" style="color:inherit; text-decoration:none;"><%= p.title %></a></h4>
<p><%= p.summary || p.excerpt || '' %></p>
<div class="progress"><div class="progress-fill" style="width:<%= p.progress || 0 %>%;"></div></div>
<div class="progress-label"><%= p.progress || 0 %>%</div>
</div>
<% }); %>
</div>
</div>
<% } %>

<div class="section-label">近期更新</div>
<div class="list">
<%
var recent = site.posts.sort('date', -1).data.filter(function(p){
  return !featuredPost || p.path !== featuredPost.path;
}).slice(0, 6);
var catClass = { '轉蛋': 'gacha', '委託': 'commission', '雜談': 'chat', '企劃': 'project' };
%>
<% recent.forEach(function(p){
var cat = p.categories && p.categories.data[0] ? p.categories.data[0].name : '';
var cls = catClass[cat] || '';
%>
<div class="row <%= cls %>">
<span class="tag"><%= cat %></span>
<div class="body"><h4><a href="<%- url_for(p.path) %>" style="color:inherit; text-decoration:none;"><%= p.title %></a></h4><p><%= p.excerpt || '' %></p></div>
<span class="date"><%= date(p.date, 'MM.DD') %></span>
</div>
<% }); %>
</div>

</div>
</div>

<!-- 引入示範版的 JS -->
<%- js('js/intro.js') %>
</body>
</html>