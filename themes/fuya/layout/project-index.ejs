<%#
  themes/landscape/layout/project-index.ejs
  企劃索引頁樣板，讀取 source/_data/projects.yml 的資料。
  要新增/調整企劃時改那份 yml 就好，不用碰這份樣板。

  對應頁面：source/project/index.md，front-matter 要寫：
  ---
  title: 企劃
  layout: project-index
  ---
%>

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<title><%= page.title %> · <%= config.title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Noto+Serif+TC:wght@400;600&family=Noto+Sans+TC:wght@300;400;500;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%- url_for('css/base.css') %>">
<link rel="stylesheet" href="<%- url_for('css/project-index.css') %>">
</head>
<body>
<div class="spine"><div class="holes"></div><div class="rule"></div></div>
<div class="tabs">
  <a class="tab home" href="<%- url_for('/') %>">主頁</a>
  <a class="tab gacha" href="<%- url_for('/categories/轉蛋/') %>">轉蛋</a>
  <a class="tab commission" href="<%- url_for('/categories/委託/') %>">委託</a>
  <a class="tab chat" href="<%- url_for('/categories/雜談/') %>">雜談</a>
  <a class="tab project active" href="<%- url_for('/project/') %>">企劃</a>
</div>

<div class="content-shift">
<div class="wrap">

  <div class="mini-mark"><div class="crumb"><a href="<%- url_for('/') %>">芙婭的文字手帳</a> → <b>企劃</b></div></div>
  <div class="page-title">企劃</div>
  <div class="page-sub">正在進行、還在構思的，都收在這裡</div>

  <div class="proj-grid">
    <%
      var tapeVariants = ['v1', 'v2', 'v3'];
      var projects = site.data.projects || [];
    %>
    <% projects.forEach(function(proj, i){
         var tapeClass = tapeVariants[i % tapeVariants.length];
    %>
      <% if (proj.status === 'idea') { %>
      <div class="proj-card placeholder">
        <div class="status idea"><span class="dot"></span><%= proj.status_label %></div>
        <h3><%= proj.title %></h3>
        <p class="plus">+</p>
      </div>
      <% } else { %>
      <a class="proj-card <%= tapeClass %>" href="<%- url_for(proj.link) %>">
        <div class="tape"></div>
        <div class="status <%= proj.status %>"><span class="dot"></span><%= proj.status_label %></div>
        <h3><%= proj.title %></h3>
        <p><%= proj.description %></p>
        <div class="progress"><div class="progress-fill <%= proj.status === 'doing' ? 'active' : 'think' %>" style="width:<%= proj.progress %>%;"></div></div>
        <div class="progress-label"><%= proj.progress %>%</div>
      </a>
      <% } %>
    <% }); %>
  </div>

</div>
</div>
</body>
</html>
